# ---------------------------------------------------------------------------
# Supabase (required)
#
# Project Settings → API in the Supabase dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Bypasses row-level security, so it is used exclusively for
# internal admin actions (provisioning an organization, sending an invitation).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Used to build invitation and magic-link redirect URLs. Vercel sets VERCEL_URL
# automatically; set this explicitly for the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Mailbox / calendar sync (optional, PRD 6.4)
#
# Shared secret the sync connector presents to POST /api/activities/ingest.
# Leave unset to keep the endpoint disabled (it returns 503).
# ---------------------------------------------------------------------------
SYNC_INGEST_SECRET=

# ---------------------------------------------------------------------------
# Gmail sync (optional)
#
# Read-only logging: emails involving a contact already in the CRM appear on
# that contact's timeline. Nothing is ever sent from the CRM.
#
# 1. Create a Google Cloud project and enable the Gmail API.
# 2. OAuth consent screen: choose **Internal** if your domain is on Google
#    Workspace. That avoids Google's verification review entirely. External
#    apps need verification plus an annual security assessment before Gmail
#    scopes work for anyone outside the test-user list.
# 3. Create an OAuth client (Web application) and add the redirect URI:
#      https://your-domain/api/gmail/callback
#      http://localhost:3000/api/gmail/callback   (for local development)
# 4. Generate the token encryption key:  openssl rand -base64 32
#
# Leave any of these unset and the feature stays off — the Mailboxes page says
# so instead of offering a button that leads nowhere.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts stored refresh tokens (AES-256-GCM). Must decode to exactly 32
# bytes. Losing it means every mailbox has to be reconnected; leaking it is
# equivalent to leaking the tokens themselves.
MAILBOX_TOKEN_KEY=
