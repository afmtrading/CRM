# ---------------------------------------------------------------------------
# Supabase (required)
#
# Project Settings → API in the Supabase dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Bypasses row-level security, so it is used exclusively for
# internal admin actions (provisioning an organization, sending an invitation).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Used to build invitation and magic-link redirect URLs. Vercel sets VERCEL_URL
# automatically; set this explicitly for the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Mailbox / calendar sync (optional, PRD 6.4)
#
# Shared secret the sync connector presents to POST /api/activities/ingest.
# Leave unset to keep the endpoint disabled (it returns 503).
# ---------------------------------------------------------------------------
SYNC_INGEST_SECRET=

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` when it triggers a
# scheduled run, and only sends it if this is set. The scheduled routes accept
# either secret, so the same value in both is fine.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Gmail sync (optional)
#
# Read-only logging: emails involving a contact already in the CRM appear on
# that contact's timeline. Nothing is ever sent from the CRM.
#
# One Google Cloud project serves every account in the CRM: FLO CRM
# (flo-crm-505116), owned by info@flo-ventures.com. Accounts are separated by
# organization_id and RLS, not by separate Google projects.
#
# 1. Create a Google Cloud project and enable the Gmail API.
# 2. OAuth consent screen: **External**, left in **Testing**, support email
#    info@flo-ventures.com. Internal would avoid the weekly reconnect below, but
#    only accepts addresses in a Workspace domain you own — no personal Gmail,
#    no outside domains. Testing accepts both, at the price of Google expiring
#    every refresh token after seven days; people click Reconnect on the
#    Mailboxes page when that happens. Limit: 100 test users.
# 3. Add each address that will connect a mailbox under **Test users**. An
#    address that is not on that list cannot sign in at all.
# 4. Create an OAuth client (Web application) and add the redirect URI:
#      https://crm.flo-ventures.com/api/gmail/callback
#      http://localhost:3001/api/gmail/callback   (for local development)
# 5. Generate the token encryption key:  openssl rand -base64 32
#
# See docs/GMAIL_SETUP.md for the full walkthrough, including the values that
# are already configured and what every error message means.
#
# Leave any of these unset and the feature stays off — the Mailboxes page says
# so instead of offering a button that leads nowhere.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts stored refresh tokens (AES-256-GCM). Must decode to exactly 32
# bytes. Losing it means every mailbox has to be reconnected; leaking it is
# equivalent to leaking the tokens themselves.
MAILBOX_TOKEN_KEY=

# Resend — outbound campaign email. Sending-access key, restricted to the
# organization's verified sending domain. The CRM runs fine without it; only
# campaigns need it.
RESEND_API_KEY=
